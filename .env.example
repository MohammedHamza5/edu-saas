# ============================================================================
# .env.example — Education SaaS
# انسخ إلى .env واملأ القيم. لا ترفع .env إلى Git أبدًا (أضفه إلى .gitignore).
# ============================================================================

# ---------- Flutter APP (قيم عامة قابلة للنشر فقط) ----------
# تُمرَّر عبر --dart-define=... أو AppConfig (ليست أسرارًا)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------- Edge Function Secrets (لا تدخل Flutter أبدًا) ----------
# تُضاف عبر: supabase secrets set NAME=value (أو Dashboard → Edge Functions → Secrets)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # بصلاحية service_role فقط
BUNNY_API_KEY=your-bunny-api-key
BUNNY_LIBRARY_ID=your-bunny-video-library-id
BUNNY_WEBHOOK_SECRET=random-long-string
FCM_SERVER_CREDENTIALS={"type":"service_account",...}   # JSON مفاتيح Firebase
FCM_PROJECT_ID=your-fcm-project

# ---------- عام ----------
APP_URL=https://app.example.com          # تطبيق Flutter Web على Cloudflare Pages
SUPABASE_WEBHOOK_VERIFICATION=false      # فعّل عند الحاجة
